<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope"
            xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing"
            xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery"
            xmlns:tdn="http://www.onvif.org/ver10/network/wsdl">
    <s:Header>
        <a:MessageID>uuid:%MSG_UUID%</a:MessageID>
        <a:To>urn:schemas-xmlsoap-org:ws:2005:04:discovery</a:To>
        <a:Action>http://schemas.xmlsoap.org/ws/2005/04/discovery/Hello</a:Action>
        <d:AppSequence InstanceId="0" MessageNumber="%MSG_NUMBER%"/>
    </s:Header>
    <s:Body>
        <d:Hello>
            <a:EndpointReference>
                <a:Address>urn:uuid:%UUID%</a:Address>
            </a:EndpointReference>
            <d:Types>tdn:NetworkVideoTransmitter</d:Types>
            <d:Scopes>%SCOPES%</d:Scopes>
            <d:XAddrs>%ADDRESS%</d:XAddrs>
            <d:MetadataVersion>0</d:MetadataVersion>
        </d:Hello>
    </s:Body>
</s:Envelope>
